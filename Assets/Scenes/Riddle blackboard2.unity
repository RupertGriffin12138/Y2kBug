MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7701556250370628601}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u5143\u65E6\u653E\u5047\u901A\u77E5\n\nX\u5E02XX\u4E2D\u5B66\u6559\u52A1\u5904\n\nFILE_STATUS:
    CORRUPTED\n\n\u7ECF\u6821\u884C\u653F\u4F1A\u8BAE\u7814\u7A76\u51B3\u5B9A,\u73B0\u5C06\u5343\u79A7\u5E74\u5143\u65E6\u5047\u671F\u5B89\u6392\u901A\u77E5\u5982\u4E0B\uFF1A\n\n\u653E\u5047\u65F6\u95F4\uFF1A\u516C\u514320?[err:
    0x0000001F]\u5E9A\u5B50\u5E74\u814A\u6708\u5EFF\u516D\u81F3\u5EFF\u516B,\u5B9C\u9759\u517B\uFF0C\u5FCC\u51FA\u884C\u3002\r\n\u6559\u804C\u5DE5\u8FD4\u6821\u65F6\u95F4\uFF1A\u4E8C\u96F6\u96F6\u96F6\u5E74\u4E00\u6708\u4E8C\u65E5\uFF08\u661F\u671Freturn_date
    \u536F\u65F6  \u81F3\u660E\u4F26\u5802\u70B9\u536F\uFF0C\u903E\u671F\u8005\u7F5A\u4FF8\u534A\u6708\u3002\n\u5B66\u751F\u8FD4\u6821\u65F6\u95F4\uFF1A\u5143\u6708\u521D\u4E09\u7167\u5E38\u3002\n\n\u6CE8\u610F\u4E8B\u9879\uFF1A\n1.\u5047\u671F\u671F\u95F4\uFF0C\u5404\u73ED\u7EA7\u9700\u505A\u597D\u95E8\u7A97\u52A0\u56FA\uFF0C\u4E25\u9632\u6714\u98CE 
    \uFF08WIND_LEVEL > 8\uFF09\u4FB5\u88AD\u3002\n2.\u5B66\u751F\u8FD4\u4E61\u9700\u5728\u820D\u76D1\u5904\u767B\u8BB0\uFF0C\u5E76\u786E\u4FDDroute_status
    = SAFE\u3002\r\n3\u3002\u52FF\u8FD1\u949F\u697C\u3002\u5F7C\u5904\u6B63\u4E3A\u65B0\u5C81\u5986\u70B9\uFF0C\u65F6\u6709\u5F02\u54CD\uFF0C\u6050\u60CA\u6270\u6E05\u68A6\u3002\r\n\u671B\u5168\u4F53\u5E08\u751F\u5468\u77E5\uFF0C\u7279\u6B64\u901A\u77E5\u3002\n\nXX\u4E2D\u5B66\u6559\u52A1\u5904\r\n\u65F6\u95F4\uFF1A1999\u5E7412\u670831\u65E5"
  m_isRightToLeft: 0
