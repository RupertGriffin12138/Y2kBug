      propertyPath: lines.Array.data[25].content
      value: "\u672C\u80FD\u7684\u8BDD\u8BED\u6700\u7EC8\u4E5F\u54BD\u4E0B\u809A\u53BB\u4E86\uFF0C\u5973\u5B69\u6014\u5728\u7A97\u524D\uFF0C\u770B\u7740\u89C6\u91CE\u4E2D\u7684\u7537\u4EBA\u5728\u9634\u5F71\u91CC\u8D8A\u9677\u8D8A\u6DF1\uFF0C\u76F4\u81F3\u5B8C\u5168\u6D88\u5931\u3002\r\n"
