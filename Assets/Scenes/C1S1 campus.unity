--- !u!114 &936400993
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 936400989}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d1b03fb3affb4790845ef6ef88c0d06f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: dlg_guard_1001
  avatar: {fileID: 1850017002}
  lines:
  - speaker: "\u59DC\u5B81"
    content: "\uFF08\u5927\u7237\u4ECA\u5929\u770B\u7740\u602A\u7606\u4EBA\u7684\uFF0C\u7B97\u4E86\uFF0C\u8FD8\u662F\u9EBB\u70E6\u4ED6\u5E2E\u6211\u5F00\u4E2A\u95E8\u5427\uFF0C\u6211\u73B0\u5728\u53EA\u60F3\u5FEB\u70B9\u56DE\u5BB6\u3002\uFF09"
  - speaker: "\u59DC\u5B81"
    content: "\u5927\u7237\uFF0C\u6211\u6628\u665A\u5728\u5B66\u6821\u91CC\u8DE8\u5E74\u6765\u7740\uFF0C\u6CA1\u6CE8\u610F\u65F6\u95F4\u5C31\u7761\u7740\u4E86\uFF0C\u4ECA\u65E9\u53D1\u73B0\u5927\u95E8\u9501\u4E86\uFF0C\u4F60\u80FD\u5E2E\u6211\u5F00\u4E0B\u95E8\u5417?  "
  - speaker: "\u95E8\u536B"
    content: ......
  - speaker: 
    content: "\u4E2D\u5E74\u7537\u4EBA\u6CA1\u6709\u56DE\u5E94\uFF0C\u9634\u5F71\u4E2D\u4F9D\u7A00\u53EF\u89C1\u7684\u534A\u8FB9\u8138\u4E0A\uFF0C\u53EA\u6709\u5634\u5728\u673A\u68B0\u5F0F\u5730\u5F20\u5408\u7740\uFF0C\u6CA1\u53D1\u51FA\u4EFB\u4F55\u58F0\u97F3\u3002"
  - speaker: "\u59DC\u5B81"
    content: "\u5927\u7237\u60A8\u600E\u4E48\u4E86\uFF0C\u8EAB\u4F53\u4E0D\u592A\u8212\u670D\u5417\uFF1F"
  - speaker: "\u59DC\u5B81"
    content: "\u521A\u624D\u90A3\u4F1A\u513F\u6211\u770B\u60A8\u4E0D\u5728\uFF0C\u73B0\u5728\u80FD\u5E2E\u6211\u5F00\u4E0B\u95E8\u5417\uFF0C\u6211\u5F97\u5148\u56DE\u5BB6\u4E86\u3002"
  - speaker: "\u95E8\u536B"
    content: ......
  - speaker: "\u65C1\u767D"
    content: "\u4F9D\u65E7\u4EE5\u6C89\u9ED8\u56DE\u5E94\u3002\u6CA1\u6709\u505C\u987F\u592A\u4E45\uFF0C\u5973\u5B69\u7EE7\u7EED\u8BF4\u9053\u3002"
  - speaker: "\u59DC\u5B81"
    content: "\u8FD8\u6709\uFF0C\u5927\u7237\uFF0C\u949F\u697C\u90A3\u513F\u597D\u50CF\u51FA\u4E86\u70B9\u95EE\u9898\uFF0C\u6628\u5929\u8FD8\u597D\u597D\u7684\u949F\u6CA1\u5728\u52A8\u4E86\uFF0C\u60A8\u77E5\u9053\u73B0\u5728\u51E0\u70B9\u4E86\u5417......"
  - speaker: "\u65C1\u767D"
    content: "\u7537\u4EBA\u50CF\u662F\u6355\u6349\u5230\u4E86\u4EC0\u4E48\uFF0C\u8EAB\u5B50\u4E00\u6FC0\u7075\uFF0C\u4E0D\u505C\u98A4\u52A8\u7740\u3002"
  - speaker: "\u95E8\u536B"
    content: "\u662F\u5B83\uFF0C\u5B83\u6765\u8FC7\u4E86...\u5B83..\u5B83\u541E\u6389\u4E86...\u5B66\u751F..\u9A6C\u4E0A\u662F...\u5B66\u6821...1\u2030@*9**00\u5E74\uFF0C\u8981\u6765\u4E86\u3002"
  - speaker: "\u65C1\u767D"
    content: "\u6B8B\u7F3A\u7684\u5B57\u53E5\u540C\u7C98\u817B\u7684\u6CA5\u9752\u4E00\u822C\u6EF4\u6302\u5728\u5730\u4E0A\uFF0C\u7537\u4EBA\u7684\u5E3D\u6A90\u4F9D\u65E7\u91CD\u91CD\u538B\u7740\u524D\u989D\uFF0C\u539F\u672C\u6DA3\u6563\u7684\u77B3\u5B54\u7A0D\u7A0D\u805A\u62E2\u8D77\u6765\uFF0C\u76EE\u5149\u4F3C\u4E4E\u843D\u5728\u524D\u65B9\u3002"
  - speaker: "\u65C1\u767D"
    content: "\u5973\u5B69\u5413\u4E86\u4E00\u8DF3\uFF0C\u9732\u51FA\u7591\u60D1\u7684\u8868\u60C5\uFF0C\u8BD5\u56FE\u4ECE\u4E0D\u7740\u8FB9\u9645\u7684\u8BDD\u8BED\u4E2D\u6574\u7406\u51FA\u4E9B\u5934\u7EEA\u3002"
  - speaker: "\u59DC\u5B81"
    content: "\uFF08\u201C\u5B83\u201D\uFF1F\u5B83\u662F\u4EC0\u4E48\uFF1F\uFF09"
  - speaker: "\u59DC\u5B81"
    content: "\uFF08\u5B66\u6821\u91CC\u53D1\u751F\u7684\u4E00\u5207\uFF0C\u548C\u201C\u5B83\u201D\u6709\u5173\u5417\uFF1F\uFF09"
  - speaker: "\u65C1\u767D"
    content: "\u4E5F\u8BB8\u662F\u5BD2\u98CE\u7684\u62CD\u6253\uFF0C\u53C8\u6216\u8BB8\u662F\u73B0\u5B9E\u7684\u51B2\u51FB\uFF0C\u5973\u5B69\u7684\u5934\u8111\u9010\u6E10\u6062\u590D\u4E86\u6E05\u6670\uFF0C\u5927\u91CF\u7684\u7591\u95EE\u968F\u4E4B\u6D8C\u51FA\u3002"
  - speaker: "\u59DC\u5B81"
    content: "\u5927\u7237\uFF0C\u4F60\u8BF4\u7684\u201C\u5B83\u201D\u662F\u4EC0\u4E48\u610F\u601D\uFF1F\u8D70\u5ECA\u91CC\u6709\u6247\u53E4\u602A\u7684\u95E8\uFF0C\u4F60\u77E5\u9053\u662F\u600E\u4E48\u56DE\u4E8B\u5417\uFF1F\u8FD8\u6709\u95F4\u6559\u5BA4\u7684\u684C\u6905\u53D8\u5F97\u5F88\u5947\u602A\uFF0C\u8FD9\u4E5F\u548C\u201C\u5B83\u201D\u6709\u5173\u7CFB\u5417\uFF1F"
  - speaker: "\u95E8\u536B"
    content: "\u5FEB...\u8FD8\u6709\u673A\u4F1A...\u5FEB\u628A\u65F6\u95F4\u8C03..."
  - speaker: "\u65C1\u767D"
    content: "\u7537\u4EBA\u50F5\u786C\u5730\u5927\u5F20\u7740\u5634\uFF0C\u60F3\u8981\u6781\u529B\u4F20\u8FBE\u7684\u8BDD\u8BED\u5374\u59CB\u7EC8\u5835\u5728\u5589\u5934\u3002"
  - speaker: "\u59DC\u5B81"
    content: "\u4EC0\u4E48\uFF1F\u5927\u7237\uFF0C\u4F60\u8981\u8BA9\u6211\u53BB\u505A\u4EC0\u4E48\u5417\uFF1F\u4F60\u80FD\u518D\u8BF4\u8BE6......"
  - speaker: 
    content: "\u5973\u5B69\u6025\u5207\u5730\u60F3\u8981\u83B7\u5F97\u66F4\u591A\u4FE1\u606F\uFF0C\u671D\u7A97\u6237\u9760\u8FD1\u4E86\u4E9B\uFF0C\u5C06\u6574\u4E2A\u8EAB\u5B50\u5411\u524D\u503E\u53BB\u3002"
  - speaker: "\u95E8\u536B"
    content: "\u4E0D...\u4E0D\u8981...\u4E0D\u8981\u8FC7\u6765\uFF01\u4F60\u8EAB\u4E0A\uFF0C\u4F60\u8EAB\u4E0A\u7684\u8863\u670D....\u5B83\u5DF2\u7ECF\u6765\u4E86\uFF0C\u5168\u90FD...\u5168\u90FD\u9003\u4E0D\u6389\u7684\uFF01"
  - speaker: "\u95E8\u536B"
    content: "\u9003\u4E0D\u6389\u4E86......\u554A..."
  - speaker: 
    content: "\u6FC0\u52A8\u7684\u7537\u4EBA\u5927\u58F0\u5BF9\u7740\u4E0D\u77E5\u4F55\u5904\u7684\u7A7A\u6C14\u558A\u53EB\uFF0C\u80F8\u90E8\u8BE1\u5F02\u7684\u4E0A\u4E0B\u8D77\u4F0F\uFF0C\u8EAB\u5F62\u626D\u66F2\uFF0C\u4EFF\u4F5B\u8981\u6574\u4E2A\u6495\u88C2\u5F00\u6765\u3002"
  - speaker: 
    content: "\u800C\u540E\uFF0C\u4ED6\u6574\u4E2A\u4EBA\u8FD1\u4E4E\u88AB\u62D6\u62FD\u822C\uFF0C\u9010\u6E10\u6D88\u5931\u5728\u9ED1\u6697\u4E2D\u3002"
  - speaker: "\u59DC\u5B81"
    content: "\u4E0D\u662F\u7684\u5927\u7237\uFF0C\u6211\u53EA\u662F\u60F3......."
  - speaker: 
    content: "\u672C\u80FD\u7684\u8BDD\u8BED\u6700\u7EC8\u4E5F\u54BD\u4E0B\u809A\u53BB\u4E86\uFF0C\u5973\u5B69\u6014\u5728\u7A97\u524D\uFF0C\u770B\u7740\u89C6\u91CE\u4E2D\u7684\u7537\u4EBA\u5728\u9634\u5F71\u91CC\u8D8A\u9677\u8D8A\u6DF1\uFF0C\u76F4\u81F3\u5B8C\u5168\u6D88\u5931\u3002"
  - speaker: 
    content: "\u53C8\u56DE\u5230\u4E86\u5B64\u96F6\u96F6\u7684\u4E00\u4EBA\uFF0C\u5979\u4F4E\u4E0B\u5934\uFF0C\u72EC\u81EA\u601D\u8003\u8D77\u6765\uFF0C\u60F3\u8981\u5C3D\u529B\u5F04\u6E05\u73B0\u5728\u7684\u60C5\u51B5\u3002"
  - speaker: "\u59DC\u5B81"
    content: "\uFF08\u5230\u5E95\u662F\u600E\u4E48\u56DE\u4E8B,\u5927\u7237\u770B\u8D77\u6765\u4E0D\u50CF\u5728\u5F00\u73A9\u7B11,\u8FD9\u602A\u5F02\u7684\u8FDD\u548C\u611F\uFF0C\u90A3\u4E9B\u7EB8\u6761\u548C\u6587\u4EF6\uFF0C\u8FD9\u91CC\u7A76\u7ADF\u53D1\u751F\u4E86\u4EC0\u4E48? 
      \uFF09"
  - speaker: "\u59DC\u5B81"
    content: "\uFF08\u201C\u5B83\u201D\u662F\u4EC0\u4E48\uFF0C\u201C\u6765\u4E86\u201D\u53C8\u662F\u4EC0\u4E48\u610F\u601D.....\uFF09"
  - speaker: 
    content: "\u9ED1\u6697\u4E2D\uFF0C\u4EC0\u4E48\u5FFD\u5730\u95EA\u8FC7\uFF0C\u7136\u800C\u6C89\u601D\u4E2D\u7684\u5973\u5B69\uFF0C\u5E76\u6CA1\u6709\u6CE8\u610F\u5230\u90A3\u4E00\u77AC\u95F4\u7684\u5149\u5F71......"
  - speaker: "\u59DC\u5B81"
    content: "\uFF08\u5BF9\u4E86\uFF0C\u5927\u7237\u8BF4\u4E86\u4EC0\u4E48\u8863\u670D\uFF0C\u6211\u7684\u6821\u670D\uFF1F\u8FD8\u662F\u521A\u521A\u6361\u5230\u7684\u90A3\u4EF6\uFF0C\u68C0\u67E5\u4E00\u4E0B\u5427\u3002\uFF09"
  playerTag: Player
  destroyAfterFinish: 1
  lockPlayerDuringDialogue: 1
  repeatMode: 0
  interactHint: "\u6309 <b>E</b> \u5BF9\u8BDD"
