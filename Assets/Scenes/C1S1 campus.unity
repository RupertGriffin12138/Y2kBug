    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: dialogueId
      value: dlg_005
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[0].content
      value: "\u98CE\u547C\u5730\u5439\u8FC7\uFF0C\u53C8\u500F\u5730\u505C\u4E0B\uFF0C\u50CF\u662F\u7A7A\u6C14\u5728\u5468\u56F4\u7A81\u7136\u6D88\u5931\uFF0C\u53C8\u51ED\u7A7A\u51FA\u73B0\u3002\u663E\u7136\uFF0C\u5B66\u6821\u7684\u5F02\u5E38\u6C14\u606F\u5E76\u4E0D\u80FD\u88AB\u4E00\u4E2A\u65E9\u516D\u665A\u5341\u7684\u9AD8\u4E2D\u751F\u8F7B\u6613\u6355\u6349\u5230..."
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[0].speaker
      value: "\u65C1\u767D"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[1].content
      value: "\uFF08\u6211\u8FD9\u662F\uFF0C\u5728\u54EA\uFF0C\u5934\u597D\u75DB\u3002\uFF09"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[1].speaker
      value: "\u59DC\u5B81"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[2].content
      value: "\u5973\u5B69\u63C9\u7740\u773C\u775B\uFF0C\u53E6\u4E00\u53EA\u624B\u629A\u5411\u540E\u9888\uFF0C\u8BD5\u56FE\u8BA9\u6765\u81EA\u5934\u90E8\u7684\u4E0D\u9002\u518D\u51CF\u8F7B\u4E9B\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[2].speaker
      value: "\u65C1\u767D"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[3].content
      value: "\uFF08\u6211\u8BB0\u5F97\u6628\u5929...\u5BF9\u3002\u4ECA\u5929\u662F2000\u5E74\u4E86\uFF0C\u6211\u548C\u4E01\u5BB6\u4FCA\u4ED6\u4EEC\u4E00\u8D77\u8DE8\u5E74\u6765\u7740\u3002\uFF09"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[3].speaker
      value: "\u59DC\u5B81"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[4].content
      value: "\uFF08\u53EF\u6211\u600E\u4E48\u8EBA\u5728\u8FD9\u5462\uFF0C\u96EA\u83B9\u4E5F\u56DE\u5BB6\u53BB\u4E86\u5417\uFF0C\u4ED6\u4EEC\u4EBA\u5462\uFF1F\uFF09\r"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[5].content
      value: "\u521A\u521A\u9192\u6765\u7684\u5979\u4EFF\u4F5B\u7ECF\u5386\u4E86\u4E00\u573A\u65E0\u6B62\u5883\u7684\u8111\u90E8\u68C0\u67E5\uFF0C\u95EE\u8BE2\u548C\u773C\u524D\u7684\u753B\u9762\u4EA4\u66FF\u7A7F\u68AD\u5728\u5DE6\u53F3\u8033\u4E2D\uFF0C\u6270\u5F97\u4EBA\u6478\u4E0D\u6E05\u73B0\u72B6\u3002\r\r"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[5].speaker
      value: "\u65C1\u767D"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[6].content
      value: "\u5973\u5B69\u56DB\u4E0B\u73AF\u89C6\uFF0C\u7EC8\u4E8E\u5728\u5B9E\u666F\u4E2D\u7A0D\u5FAE\u5398\u6E05\u4E9B\u8111\u888B\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[6].speaker
      value: "\u65C1\u767D"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[7].content
      value: "\uFF08\u8FD9\u7FA4\u5BB6\u4F19\uFF0C\u8FD8\u7559\u4E86\u4E0D\u5C11\u4E1C\u897F\u5728\u8FD9\u5462\u3002\uFF09\r"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[7].speaker
      value: "\u59DC\u5B81"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[8].content
      value: "\u7537\u4EBA\u50CF\u662F\u6355\u6349\u5230\u4E86\u4EC0\u4E48\uFF0C\u8EAB\u5B50\u4E00\u6FC0\u7075\uFF0C\u4E0D\u505C\u98A4\u52A8\u7740\u3002\r"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[8].speaker
      value: "\u65C1\u767D"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[9].content
      value: "\u662F\u5B83\uFF0C\u5B83\u6765\u8FC7\u4E86...\u5B83..\u5B83\u541E\u6389\u4E86...\u5B66\u751F..\u9A6C\u4E0A\u662F...\u5B66\u6821...1\u2030@*9**00\u5E74\uFF0C\u8981\u6765\u4E86\u3002\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[9].speaker
      value: "\u95E8\u536B"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[10].content
      value: "\u6B8B\u7F3A\u7684\u5B57\u53E5\u540C\u7C98\u817B\u7684\u6CA5\u9752\u4E00\u822C\u6EF4\u6302\u5728\u5730\u4E0A\uFF0C\u7537\u4EBA\u7684\u5E3D\u6A90\u4F9D\u65E7\u91CD\u91CD\u538B\u7740\u524D\u989D\uFF0C\u539F\u672C\u6DA3\u6563\u7684\u77B3\u5B54\u7A0D\u7A0D\u805A\u62E2\u8D77\u6765\uFF0C\u76EE\u5149\u4F3C\u4E4E\u843D\u5728\u524D\u65B9\u3002\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[10].speaker
      value: "\u65C1\u767D"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[11].content
      value: "\u5973\u5B69\u5413\u4E86\u4E00\u8DF3\uFF0C\u9732\u51FA\u7591\u60D1\u7684\u8868\u60C5\uFF0C\u8BD5\u56FE\u4ECE\u4E0D\u7740\u8FB9\u9645\u7684\u8BDD\u8BED\u4E2D\u6574\u7406\u51FA\u4E9B\u5934\u7EEA\u3002\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[12].content
      value: "\uFF08\u201C\u5B83\u201D\uFF1F\u5B83\u662F\u4EC0\u4E48\uFF1F\uFF09\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[12].speaker
      value: "\u59DC\u5B81"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[13].content
      value: "\uFF08\u5B66\u6821\u91CC\u53D1\u751F\u7684\u4E00\u5207\uFF0C\u548C\u201C\u5B83\u201D\u6709\u5173\u5417\uFF1F\uFF09\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[14].content
      value: "\u4E5F\u8BB8\u662F\u5BD2\u98CE\u7684\u62CD\u6253\uFF0C\u53C8\u6216\u8BB8\u662F\u73B0\u5B9E\u7684\u51B2\u51FB\uFF0C\u5973\u5B69\u7684\u5934\u8111\u9010\u6E10\u6062\u590D\u4E86\u6E05\u6670\uFF0C\u5927\u91CF\u7684\u7591\u95EE\u968F\u4E4B\u6D8C\u51FA\u3002\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[14].speaker
      value: "\u65C1\u767D"
      objectReference: {fileID: 0}
    - target: {fileID: 6305279910839724799, guid: b734b3b8cac05b34e9eee789d009a45a, type: 3}
      propertyPath: lines.Array.data[15].content
      value: "\u5927\u7237\uFF0C\u4F60\u8BF4\u7684\u201C\u5B83\u201D\u662F\u4EC0\u4E48\u610F\u601D\uFF1F\u8D70\u5ECA\u91CC\u6709\u6247\u53E4\u602A\u7684\u95E8\uFF0C\u4F60\u77E5\u9053\u662F\u600E\u4E48\u56DE\u4E8B\u5417\uFF1F\u8FD8\u6709\u95F4\u6559\u5BA4\u7684\u684C\u6905\u53D8\u5F97\u5F88\u5947\u602A\uFF0C\u8FD9\u4E5F\u548C\u201C\u5B83\u201D\u6709\u5173\u7CFB\u5417\uFF1F\r\n"
