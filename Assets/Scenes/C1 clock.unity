  - speaker: "\u65C1\u767D"
    content: "\u6B63\u5728\u8FD0\u884C"
  - speaker: 
    content: "\u4E0D\u77E5\u9053\u4ECE\u4EC0\u4E48\u5730\u65B9\u4F20\u6765\u7684\u7535\u5B50\u97F3\u6548,\u4EE3\u8868\u7740\u4EC0\u4E48\u4EBA\u7684\u4E16\u754C\u6D88\u5931\u4E86\u5417\uFF1F\u6291\u6216\u662F\uFF0C\u4EC0\u4E48\u4E8B\u7269\u88AB\u201C\u4FEE\u6B63\u201D\u4E86\u3002\n"
  - speaker: 
    content: "\u5F52\u6839\u7ED3\u5E95\uFF0C\u4ECA\u5929\u5230\u5E95\u662F\uFF0C\u54EA\u4E00\u5929\u5462...\n"
